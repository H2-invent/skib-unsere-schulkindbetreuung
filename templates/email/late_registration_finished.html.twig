{% extends 'email/base.html.twig' %}
{% block header %}
    {% trans %}Nachmeldung abgeschlossen{% endtrans %}
{% endblock %}

{% block content %}
    <h4 class="text-center">
        {% trans %}Die Nachmeldung wurde erfolgreich abgeschlossen. Bitte bearbeiten Sie die Nachmeldung zum nächstmöglichen Zeitpunkt.{% endtrans %}
    </h4>

    <center>
        <button href="{{ absolute_url(path('block_schule_schow', {'id': stammdaten.kinds.0.schule.id })) }}">
            {% trans %}Bearbeiten{% endtrans %}
        </button>
    </center>

    <p class="text-center">
        <b>{{ stammdaten.vorname }} {{ stammdaten.name }}</b>
        <br>
        {{ lateRegistration.email }}
    </p>

    <br>

    <p class="text-center">
        {% trans %}Folgende Kinder wurden angemeldet:{% endtrans %}
    </p>

    <ul>
        {% for kind in stammdaten.kinds %}
            <li>
                <b>{{ kind.vorname }} {{ kind.nachname }}</b>
            </li>
        {% endfor %}
    </ul>


{% endblock %}
