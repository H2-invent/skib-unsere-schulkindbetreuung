{% extends 'workflow/base.html.twig' %}

{% block header %}
    <div class="col-md-8 mb-4 white-text text-center text-md-left">
        <h1 class="h1-responsive">{{ 'Ferienprogramm'|trans }}</h1>
        <hr class="hr-light">
    </div>
{% endblock %}

{% block content %}
    <div class="mb-4">
        <h2>{{ 'Ferienprogramme'|trans }}</h2>
        <p class="text-muted">
            {{ 'Hier finden Sie alle zukünftigen Ferienprogramme, die aktuell oder demnächst buchbar sind.'|trans }}
        </p>
    </div>

    {% for ferienprogramm in ferienprogramme %}
        <article class="card mb-4">
            <div class="card-body">
                <div class="d-flex flex-column flex-md-row justify-content-between">
                    <div>
                        <h3 class="card-title h4">{{ ferienprogramm.translate.titel }}</h3>
                        <p class="mb-2">
                            <strong>{{ ferienprogramm.startDate|date('d.m.Y') }}{% if ferienprogramm.startDate|date('Y-m-d') != ferienprogramm.endDate|date('Y-m-d') %} – {{ ferienprogramm.endDate|date('d.m.Y') }}{% endif %}</strong>,
                            {{ ferienprogramm.startTime|date('H:i') }} – {{ ferienprogramm.endTime|date('H:i') }} {{ 'Uhr'|trans }}
                        </p>
                    </div>
                    <div class="text-md-right mb-3">
                        {% if ferienprogramm.startVerkauf <= today %}
                            <span class="badge badge-success">{{ 'Anmeldung geöffnet'|trans }}</span>
                        {% else %}
                            <span class="badge badge-info">
                                {{ 'Anmeldung ab'|trans }} {{ ferienprogramm.startVerkauf|date('d.m.Y') }}
                            </span>
                        {% endif %}
                    </div>
                </div>

                {% if ferienprogramm.translate.infoText %}
                    <p>{{ ferienprogramm.translate.infoText|nl2br }}</p>
                {% endif %}

                <dl class="row mb-0">
                    <dt class="col-sm-3">{{ 'Ort'|trans }}</dt>
                    <dd class="col-sm-9">{{ ferienprogramm.ort|nl2br }}</dd>

                    <dt class="col-sm-3">{{ 'Anmeldezeitraum'|trans }}</dt>
                    <dd class="col-sm-9">{{ ferienprogramm.startVerkauf|date('d.m.Y') }} – {{ ferienprogramm.endVerkauf|date('d.m.Y') }}</dd>

                    <dt class="col-sm-3">{{ 'Preise'|trans }}</dt>
                    <dd class="col-sm-9">
                        <ul class="list-unstyled mb-0">
                            {% for preis in ferienprogramm.preis %}
                                <li>
                                    {% if ferienprogramm.namePreise[loop.index0] is defined and ferienprogramm.namePreise[loop.index0] %}
                                        {{ ferienprogramm.namePreise[loop.index0] }}:
                                    {% endif %}
                                    <strong>{{ preis|number_format(2, ',', '.') }} €</strong>
                                </li>
                            {% else %}
                                <li>{{ 'Keine Preisangabe'|trans }}</li>
                            {% endfor %}
                        </ul>
                    </dd>
                </dl>
            </div>
        </article>
    {% else %}
        <div class="alert alert-info" role="status">
            {{ 'Aktuell sind keine zukünftigen Ferienprogramme vorhanden.'|trans }}
        </div>
    {% endfor %}
{% endblock %}
