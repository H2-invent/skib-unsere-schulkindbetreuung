{% extends 'adminBase.html.twig' %}

{% block content %}
    <section class="dashboard-counts section-padding">
        <div class="container-fluid ">
            <div class="row">
                <div class=" col-12 card">
                    <div class="card-header">
                        <div class="row">
                            <div class="col">
                                <h1>{{ 'Buchhaltung'|trans }}</h1>
                            </div>
                            <div class="col text-right">
                                <button type="button" data-toggle="modal" data-target="#newSepa" class="btn btn-success">
                                    {{ 'SEPA Lastschrift erstellen'|trans }}
                                </button>
                            </div>
                        </div>
                        <hr>
                    </div>
                    <div class="card-body">
                        <div>
                            <div class="modal fade" id="newSepa" tabindex="-1" role="dialog"
                                 aria-labelledby="exampleModalLabel" aria-hidden="true">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title"
                                                id="exampleModalLabel">{{ 'SEPA Lastschrift erstellen'|trans }}</h5>
                                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                                <span aria-hidden="true">&times;</span>
                                            </button>
                                        </div>
                                        <div class="modal-body">
                                            {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    {{ form_label(form.von) }}
                                                    {{ form_widget(form.von.day,{'attr':{'class':'d-none ' }}) }}
                                                    {{ form_row(form.von.month) }}
                                                    {{ form_row(form.von.year) }}
                                                </div>
                                            </div>
                                            <div class="row">
                                                <div class="col-lg-12">
                                                    {{ form_row(form.einzugsDatum) }}
                                                </div>
                                            </div>
                                            <div class="row mt-4">
                                                <div class="col-lg-12">
                                                    {{ form_row(form.save) }}
                                                </div>
                                            </div>
                                            {{ form_end(form) }}
                                        </div>
                                        {#<div class="modal-footer">
                                            <button type="button" class="btn btn-light" data-dismiss="modal">{{ 'Schließen'|trans }}</button>
                                        </div>#}
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-lg-12">
                                <div class="table-responsive">
                                    <table class="table table-hover">
                                        <thead>
                                        <tr>
                                            <th></th>
                                            <th>ID</th>
                                            <th>{% trans %}Summe{% endtrans %}</th>
                                            <th>{% trans %}Anzahl{% endtrans %}</th>
                                            <th>{% trans %}Von{% endtrans %}</th>
                                            <th>{% trans %}Bis{% endtrans %}</th>
                                            <th>{% trans %}Einzugsdatum{% endtrans %}</th>
                                            <th>{% trans %}Angelegt{% endtrans %}</th>
                                        </tr>
                                        </thead>
                                        <tbody>
                                        {% for s in sepa %}
                                            <tr>
                                                <td>
                                                    <div class="btn-group">
                                                        <button class="btn bmd-btn-icon dropdown-toggle" type="button"
                                                                id="ex2" data-toggle="dropdown" aria-haspopup="true"
                                                                aria-expanded="false">
                                                            <i class="material-icons">more_vert</i>
                                                        </button>
                                                        <div class="dropdown-menu dropdown-menu-left"
                                                             aria-labelledby="ex2">
                                                            <a class="dropdown-item"
                                                               href="{{ path('accounting_sepa_detail',{'id':s.id}) }}">Detail</a>
                                                            <a class="dropdown-item"
                                                               href="{{ path('accounting_sepa_printXML',{'id':s.id}) }}">{% trans %}Download SEPA-XML{% endtrans %}</a>
                                                            <a class="dropdown-item"
                                                               href="{{ path('accounting_sepa_printExcel',{'sepa_id':s.id}) }}">{% trans %}Download Excel{% endtrans %}</a>
                                                            {% if is_granted('ROLE_ORG_INFOMA_EXPORT') %}
                                                                <button class="dropdown-item" type="button" data-toggle="modal" data-target="#infomaExport{{ s.id }}">
                                                                    {% trans %}Download Infoma-CSV{% endtrans %}
                                                                </button>
                                                            {% endif %}
                                                            <a class="dropdown-item deleteBtn" type="GET"
                                                               href="{{ path('accounting_send_bill',{'sepa_id':s.id}) }}">{% trans %}Rechnung an alle Erziehungsberechtigten versenden{% endtrans %}</a>

                                                        </div>
                                                    </div>
                                                </td>
                                                <td>{{ s.id }}</td>
                                                <td>{{ s.summe|number_format(2,',','.') }}</td>
                                                <td>{{ s.anzahl }}</td>
                                                <td>{{ s.von|date('d.m.Y') }}</td>
                                                <td>{{ s.bis|date('d.m.Y') }}</td>
                                                <td>{{ s.einzugsdatum|date('d.m.Y') }}</td>
                                                <td>{{ s.createdAt|date('d.m.Y') }}</td>
                                            </tr>
                                        {% endfor %}
                                        </tbody>
                                    </table>
                                    {% for s in sepa %}
                                            {% if is_granted('ROLE_ORG_INFOMA_EXPORT') %}
                                                <div class="modal fade" id="infomaExport{{ s.id }}" tabindex="-1" role="dialog" aria-labelledby="infomaExportLabel{{ s.id }}" aria-hidden="true">
                                                    <div class="modal-dialog" role="document"><div class="modal-content">
                                                        <form method="post" action="{{ path('accounting_sepa_print_infoma') }}">
                                                            <div class="modal-header"><h5 class="modal-title" id="infomaExportLabel{{ s.id }}">{% trans %}Infoma-CSV erstellen{% endtrans %}</h5><button type="button" class="close" data-dismiss="modal" aria-label="Schließen"><span aria-hidden="true">&times;</span></button></div>
                                                            <div class="modal-body">
                                                                <input type="hidden" name="sepa_id" value="{{ s.id }}"><input type="hidden" name="_token" value="{{ csrf_token('infoma-export-' ~ s.id) }}">
                                                                <div class="form-group"><label for="infomaExternalSystemId{{ s.id }}">{% trans %}Infoma Extern-ID{% endtrans %}</label><input class="form-control" id="infomaExternalSystemId{{ s.id }}" name="external_system_id" maxlength="10" required pattern="[A-Za-z0-9.-]+" placeholder="EXTSYS"></div>
                                                                <div class="form-group"><label for="infomaPaymentMethod{{ s.id }}">{% trans %}Zahlungsformcode{% endtrans %}</label><input class="form-control" id="infomaPaymentMethod{{ s.id }}" name="payment_method_code" maxlength="20" required pattern="[A-Za-z0-9.-]+" placeholder="SEPA-LS"></div>
                                                                <div class="form-group"><label for="infomaAccount{{ s.id }}">{% trans %}Erlöskonto{% endtrans %}</label><input class="form-control" id="infomaAccount{{ s.id }}" name="account" maxlength="20" required pattern="[A-Za-z0-9.-]+"></div>
                                                                <div class="form-group"><label for="infomaCounterAccount{{ s.id }}">{% trans %}Bank-/Verrechnungskonto{% endtrans %}</label><input class="form-control" id="infomaCounterAccount{{ s.id }}" name="counter_account" maxlength="20" required pattern="[A-Za-z0-9.-]+"></div>
                                                            </div>
                                                            <div class="modal-footer"><button type="button" class="btn btn-light" data-dismiss="modal">{% trans %}Abbrechen{% endtrans %}</button><button type="submit" class="btn btn-primary">{% trans %}CSV herunterladen{% endtrans %}</button></div>
                                                        </form>
                                                    </div></div>
                                                </div>
                                            {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>

                    </div>


                </div>
            </div>
        </div>
    </section>

{% endblock %}

{% block jquery %}
<script>
    $()
</script>

{% endblock %}
